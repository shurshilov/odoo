<?xml version="1.0" encoding="UTF-8"?>
<template>

    <t t-name="mail.ChatterTopbarGooglePicker"
       t-inherit="mail.ChatterTopbar"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonAddAttachments')]" position="after">
                <t t-if="!_openAttachmentManager">
                    <button class="o_ChatterTopbar_button o_ChatterTopbar_buttonAddAttachments btn btn-light btn-primary"
                    type="button" t-att-disabled="!chatterTopbar.chatter.hasWriteAccess" t-on-click="_onGoogleDrivePicker" >
                        <div class="o_AttachmentBox_buttonAdd btn btn-link"
                            style="width:15px;height:15px;margin:0;padding:0;background-image: url(/google_drive_picker/static/description/gdrive.svg); background-repeat: no-repeat;">
                        </div>
                    </button>
                </t>
                
        </xpath>
    </t>
</template>