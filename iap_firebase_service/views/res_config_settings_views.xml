<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_messodoo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.messodoo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <div id="business_documents" position="after">
                    <h2 id="firebase">Messodoo service key IAP</h2>
                        <div>
                            <div class="col-12 col-lg-12 o_setting_box" title="Messodoo service key IAP">
                                <div class="o_setting_left_pane">
                                    <field name="messodoo_service_key"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Messodoo service key IAP</span>
                                </div>
                            </div>
                        </div>
                </div> 
        </field>
    </record>

    <record id="res_config_settings_view_form_iap_firebase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.iap.farebase</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <div id="business_documents" position="after">
                    <h2 id="firebase">IAP Firebase</h2>
                        <div>
                            <div class="col-12 col-lg-12 o_setting_box" title="Firebase key">
                                <div class="o_setting_left_pane">
                                    <field name="firebase_key"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Firebase key</span>
                                </div>
                            </div>
                        </div>
                </div> 
        </field>
    </record>
</odoo>
